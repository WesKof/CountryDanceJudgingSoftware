import test from 'node:test';
import assert from 'node:assert/strict';
import {writeFileSync,mkdirSync,readFileSync} from 'node:fs';
import {api,command,save,submitHeat} from './stage-helpers.ts';
import {createStage,limitedStage,finish,exact,owner,fault,receiver,localKey} from './publication-helpers.ts';
import {snapshotFingerprint} from '../lib/live/publication.ts';
import type {LiveView} from '../lib/live/types.ts';

test('local publication protocol: independent approvals, immutable revision, under-review, suspension, failure retry and privacy', {timeout:180000},async(t)=>{
 await fault(false);await owner({action:'service',state:'enabled'});
 const setup=limitedStage(),{organizer,tokens,head,path}=await createStage(setup);let view=await finish(setup,organizer,tokens,head);const competitionId=setup.competitions[0].id;
 await t.test('unapproved competitions and non-owner releases fail; public payload is allowlisted',async()=>{
   await command(organizer,{action:'prepare-publication',competitionId:setup.competitions[1].id},400);
   await command(tokens[0],{action:'prepare-publication',competitionId},403);
   await command(organizer,{action:'prepare-publication',competitionId});view=await api<LiveView>(organizer);const p=view.publications![0];
   assert.equal(p.status,'prepared');assert.equal(p.snapshot.stages.length,2);assert.equal(p.snapshot.stages[1].entrants[0].average,10);assert.equal(p.snapshot.stages[1].entrants[1].average,4.5);assert.ok(p.snapshot.stages[1].marks.some((m)=>m.mark===''));
   const payload=JSON.stringify(p.snapshot);for(const sentinel of ['PUBLICATION_PRIVATE_NOTE_SENTINEL',setup.organizerParticipantId!,...setup.judges.map((j)=>j.participantId!),...tokens,'PRIVATE_SELECTION_SENTINEL'])assert.ok(!payload.includes(sentinel));
   assert.ok(!JSON.stringify(await api<LiveView>(tokens[0])).includes(setup.organizerParticipantId!));assert.equal((await api<LiveView>(tokens[0])).setup.organizerName,undefined);const judged=JSON.stringify(await api<LiveView>(tokens[0]));for(const identity of [setup.organizerParticipantId!,...setup.judges.map((j)=>j.participantId!)])assert.ok(!judged.includes(identity));
   await owner({action:'release',publicationId:p.id,sourceFingerprint:p.sourceFingerprint},403,organizer);await owner({action:'release',publicationId:p.id,sourceFingerprint:p.sourceFingerprint},403,tokens[0]);await owner({action:'release',publicationId:p.id,sourceFingerprint:p.sourceFingerprint},400);
   await command(organizer,{action:'approve-publication',publicationId:p.id,sourceFingerprint:p.sourceFingerprint});
   await fault(true);const release=await owner({action:'release',publicationId:p.id,sourceFingerprint:p.sourceFingerprint});assert.ok(Number(release.pending)>0);assert.equal((await api<LiveView>(organizer)).publications![0].status,'queued');
   // Outbox survives fresh reads; no result table is mixed before retry succeeds.
   assert.ok(!JSON.stringify(await(await fetch(receiver+'/api/public')).json()).includes(p.id));await fault(false);await owner({action:'retry'});view=await api<LiveView>(organizer);assert.equal(view.publications![0].status,'released');await owner({action:'release',publicationId:p.id,sourceFingerprint:p.sourceFingerprint},400);
 });
 const old=view.publications![0];
 await t.test('receiver authenticates exact payload, deduplicates delivery IDs and rejects altered/order/scope references',async()=>{
   const store=JSON.parse(readFileSync(process.env.LOCAL_TEST_RECEIVER_STORE ?? (receiver.endsWith(':3110')?'work/compiled-public-receiver.json':'work/public-receiver.json'),'utf8')) as {receipts:Record<string,string>};
   const original=Object.values(store.receipts).map((raw)=>JSON.parse(raw)).find((m)=>m.kind==='release'&&m.payload.id===old.id);assert.ok(original);
   const send=async(message:unknown,key=localKey('LOCAL_RECEIVER_KEY'))=>fetch(receiver+'/receive',{method:'POST',headers:{Authorization:'Bearer '+key,'Content-Type':'application/json'},body:JSON.stringify(message)});
   assert.equal((await send(original)).status,200);assert.equal((await send(original,tokens[0])).status,403);
   const different=structuredClone(original);different.payload.snapshot.event.name+=' altered';assert.equal((await send(different)).status,409);different.deliveryId=crypto.randomUUID();assert.equal((await send(different)).status,409);
   // Even a self-consistent rehash cannot claim an unapproved source.
   different.payload.snapshot.sourceFingerprint=await snapshotFingerprint(different.payload.snapshot);different.payload.sourceFingerprint=different.payload.snapshot.sourceFingerprint;assert.equal((await send(different)).status,409);
   for(const kind of ['revision','scope','note']){const bad=structuredClone(original);bad.deliveryId=crypto.randomUUID();if(kind==='revision'){bad.payload.revision=3;bad.payload.snapshot.revision=3;}else if(kind==='scope'){bad.payload.snapshot.eventId='p-other-event';}else{bad.payload.snapshot.privateNotes='NO_PRIVATE_FIELDS';}bad.payload.sourceFingerprint=bad.payload.snapshot.sourceFingerprint=await snapshotFingerprint(bad.payload.snapshot);assert.equal((await send(bad)).status,409);}
   const attestation=await fetch((process.env.LIVE_TEST_URL ?? 'http://127.0.0.1:3000')+'/api/publication-source',{method:'POST',headers:{Authorization:'Bearer '+tokens[0],'Content-Type':'application/json'},body:JSON.stringify({publicationId:old.id})});assert.equal(attestation.status,403);assert.deepEqual(await attestation.json(),{valid:false});
 });
 await t.test('post-publication exact correction keeps original official values until a separately approved revision',async()=>{
   const r=view.rounds.find((r)=>r.definition.kind==='finals'&&r.definition.competitionId===competitionId)!,h=r.definition.heats[0],sub=view.heatSubmissions!.find((s)=>s.roundKey===r.key&&s.judgeId===setup.judges[0].id)!;
   const correction={action:'request-correction',roundKey:r.key,heatId:h.id,judgeId:sub.judgeId,submissionId:sub.id,changes:[{performanceId:h.songs[0].id,subjectId:h.subjectIds[0],after:'A1'}],reason:'PRIVATE_CORRECTION_REASON'};
   await command(tokens[0],correction,403);const requested=await command(organizer,correction) as {reviewRequestId:string};
   await command(head,{action:'approve-request',reviewRequestId:requested.reviewRequestId,requestVersion:1});assert.equal((await api<LiveView>(organizer)).publications![0].underReview,false);
   await command(organizer,{action:'approve-request',reviewRequestId:requested.reviewRequestId,requestVersion:1});view=await api<LiveView>(organizer);assert.equal(view.publications![0].underReview,true);assert.equal(view.publications![0].snapshot.stages[1].entrants[0].average,10);const reviewed=JSON.stringify(await api<LiveView>(head));assert.ok(!reviewed.includes(setup.organizerParticipantId!));for(const j of setup.judges)assert.ok(!reviewed.includes(j.participantId!));
   await owner({action:'service',state:'suspended'});await owner({action:'retry'});let publicData=JSON.stringify(await(await fetch(receiver+'/api/public')).json());assert.ok(publicData.includes('"underReview":true'));assert.ok(!publicData.includes('PRIVATE_CORRECTION_REASON'));await command(organizer,{action:'prepare-publication',competitionId},400);
   await exact(head,r.id,'approve');await command(organizer,{action:'prepare-publication',competitionId});view=await api<LiveView>(organizer);const revision=view.publications!.find((p)=>p.revision===2)!;assert.ok(Math.abs(revision.snapshot.stages[1].entrants[0].average!-(4.5+10+10)/3)<1e-9);
   await command(organizer,{action:'approve-publication',publicationId:revision.id,sourceFingerprint:revision.sourceFingerprint});await owner({action:'release',publicationId:revision.id,sourceFingerprint:revision.sourceFingerprint},400);
   // Operational review of the other competition continues while publishing is suspended.
   const other=view.rounds.find((r)=>r.definition.kind==='finals'&&r.definition.competitionId!==competitionId)!;await exact(head,other.id,'approve');await owner({action:'service',state:'enabled'});
   await owner({action:'release',publicationId:revision.id,sourceFingerprint:revision.sourceFingerprint});view=await api<LiveView>(organizer);assert.equal(view.publications!.find((p)=>p.id===revision.id)!.status,'released');
   assert.ok((await(await fetch(receiver+'/results/'+old.id)).text()).includes('Superseded'));assert.ok((await(await fetch(receiver+'/competition/'+revision.snapshot.eventId+'/'+revision.snapshot.competitionId)).text()).includes('Revision 2'));
   publicData=JSON.stringify(await(await fetch(receiver+'/api/public')).json());assert.ok(publicData.includes(old.id)&&publicData.includes(revision.id));
   const forged={deliveryId:crypto.randomUUID(),kind:'release',payload:{...revision,status:'queued',organizerApprovedAt:'now',ownerApprovedAt:'now'}};const duplicate=await fetch(receiver+'/receive',{method:'POST',headers:{Authorization:'Bearer '+localKey('LOCAL_RECEIVER_KEY'),'Content-Type':'application/json'},body:JSON.stringify(forged)});assert.equal(duplicate.status,409);
   await owner({action:'service',state:'shutdown'});assert.equal((await api<LiveView>(organizer)).status,'active');assert.ok((await api(organizer,{action:'backup',requestId:crypto.randomUUID()})).history);await owner({action:'service',state:'enabled'});
 });
 mkdirSync('work',{recursive:true});writeFileSync('work/publication-restart-fixture.json',JSON.stringify({organizer,tokens,path,eventId:view.eventId,publicationIds:view.publications!.filter((p)=>p.status==='released').map((p)=>p.id)}));
});

test('entrant withdrawal: organizer-only exact version, cancellation, ack race, all-withdrawn heat and immutable history',async()=>{
 const setup=limitedStage(1,1);setup.rounds[1].finalistCount=1;const {organizer,tokens,head}=await createStage(setup);await command(organizer,{action:'open-stage',kind:'prelims'});let view=await api<LiveView>(organizer);const r=view.rounds[0],h=r.definition.heats[0],subjectId=h.subjectIds[0];
 await save(tokens[0],r,h.songs[0].id,subjectId,'Yes','RETAIN_WITHDRAWN_NOTE');const q={action:'request-withdrawal',roundKey:r.key,competitionId:r.definition.competitionId,subjectId,reason:'PRIVATE_WITHDRAWAL_REASON'};await command(tokens[0],q,403);
 const cancelled=await command(organizer,q) as {reviewRequestId:string};await command(organizer,{action:'cancel-request',reviewRequestId:cancelled.reviewRequestId,requestVersion:1});await command(head,{action:'approve-request',reviewRequestId:cancelled.reviewRequestId,requestVersion:1},400);
 const requested=await command(organizer,q) as {reviewRequestId:string};await command(head,{action:'approve-request',reviewRequestId:requested.reviewRequestId,requestVersion:1});await command(organizer,{...q,reviewRequestId:requested.reviewRequestId,reason:'Revised exact reason'});await command(head,{action:'approve-request',reviewRequestId:requested.reviewRequestId,requestVersion:1},409);
 await command(organizer,{action:'approve-request',reviewRequestId:requested.reviewRequestId,requestVersion:2});assert.equal((await api<LiveView>(organizer)).rounds[0].definition.withdrawnIds!.length,0);const stale=await api<LiveView>(tokens[0]);
 await command(head,{action:'approve-request',reviewRequestId:requested.reviewRequestId,requestVersion:2});view=await api<LiveView>(organizer);assert.deepEqual(view.rounds[0].definition.withdrawnIds,[subjectId]);await save(tokens[0],r,h.songs[0].id,subjectId,'No','',400);
 const own=await api<LiveView>(tokens[0]);assert.ok(Object.values(own.ballots[0].cells).some((c)=>c.mark==='Yes'&&c.note==='RETAIN_WITHDRAWN_NOTE'));assert.ok(own.ballots[0].version>stale.ballots[0].version);
 await command(organizer,{action:'next'});await command(organizer,{action:'lineup'});await command(organizer,{action:'conclude-stage'},400);for(const token of tokens)await submitHeat(token,r,h.id);await command(organizer,{action:'conclude-stage'});view=await api<LiveView>(organizer);assert.equal(view.rounds[0].standings!.complete,true);assert.equal(view.rounds[0].standings!.rows.length,0);const backup=await api(organizer,{action:'backup',requestId:crypto.randomUUID()});assert.ok(JSON.stringify(backup).includes('"mark":"Yes"'));assert.ok(!JSON.stringify(backup).includes('RETAIN_WITHDRAWN_NOTE'));
});

test('queued source invalidation cannot publish stale results; outage does not block judging, correction or recovery',async()=>{
 await owner({action:'service',state:'enabled'});await fault(true);const setup=limitedStage(1,4),{organizer,tokens,head}=await createStage(setup);let v=await finish(setup,organizer,tokens,head,false);await command(organizer,{action:'prepare-publication',competitionId:setup.competitions[0].id});v=await api<LiveView>(organizer);const old=v.publications![0];await command(organizer,{action:'approve-publication',publicationId:old.id,sourceFingerprint:old.sourceFingerprint});await owner({action:'release',publicationId:old.id,sourceFingerprint:old.sourceFingerprint});assert.equal((await api<LiveView>(organizer)).publications![0].status,'queued');
 const r=v.rounds.find((r)=>r.definition.kind==='finals')!,h=r.definition.heats[0],sub=v.heatSubmissions!.find((s)=>s.roundKey===r.key&&s.judgeId===setup.judges[0].id)!;const request=await command(organizer,{action:'request-correction',roundKey:r.key,heatId:h.id,judgeId:sub.judgeId,submissionId:sub.id,changes:[{performanceId:h.songs[0].id,subjectId:h.subjectIds[0],after:'A1'}],reason:'Synthetic delivery-race source correction'}) as {reviewRequestId:string};await command(organizer,{action:'approve-request',reviewRequestId:request.reviewRequestId,requestVersion:1});await command(head,{action:'approve-request',reviewRequestId:request.reviewRequestId,requestVersion:1});assert.equal((await api<LiveView>(organizer)).publications![0].status,'stale');await owner({action:'release',publicationId:old.id,sourceFingerprint:old.sourceFingerprint},400);const backup=await api(organizer,{action:'backup',requestId:crypto.randomUUID()});assert.ok(backup.history);
 await fault(false);await owner({action:'retry'});assert.ok(!JSON.stringify(await(await fetch(receiver+'/api/public')).json()).includes(old.id));await exact(head,r.id,'approve');await command(organizer,{action:'prepare-publication',competitionId:setup.competitions[0].id});v=await api<LiveView>(organizer);const fresh=v.publications!.find((p)=>p.status==='prepared')!;assert.notEqual(fresh.id,old.id);assert.equal(fresh.revision,1);await command(organizer,{action:'approve-publication',publicationId:fresh.id,sourceFingerprint:fresh.sourceFingerprint});await owner({action:'release',publicationId:fresh.id,sourceFingerprint:fresh.sourceFingerprint});assert.equal((await api<LiveView>(organizer)).publications!.find((p)=>p.id===fresh.id)!.status,'released');assert.ok(Math.abs(fresh.snapshot.stages[1].entrants[0].average!-(4.5+10+10)/3)<1e-9);
});
