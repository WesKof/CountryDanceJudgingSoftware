import test from 'node:test';
import assert from 'node:assert/strict';
import {api,command,save,submitHeat} from './stage-helpers.ts';
import {createStage,limitedStage,finish,exact} from './publication-helpers.ts';
import {stageFixture} from './stage-fixture.ts';
import {cellKey,type LiveView} from '../lib/live/types.ts';
test('J&J exact undanced pairing withdrawal preserves past marks and resets stale heat review',async()=>{
 const setup=stageFixture(undefined,3),competition=setup.competitions[2];setup.competitions=[competition];setup.rounds=setup.rounds.filter((r)=>r.competitionId===competition.id);setup.blocks=setup.blocks.map((b)=>({...b,roundIds:b.roundIds.filter((id)=>setup.rounds.some((r)=>r.id===id))}));
 const {organizer,tokens,head}=await createStage(setup);await command(organizer,{action:'open-stage',kind:'prelims'});let v=await api<LiveView>(organizer);const r=v.rounds[0],h=r.definition.heats[0],id=r.definition.subjects[0].id,leads=r.definition.subjects.filter((s)=>s.role==='Lead'&&s.id!==id),follows=r.definition.subjects.filter((s)=>s.role==='Follow');
 for(const token of tokens)for(const subject of r.definition.subjects)await save(token,r,h.songs[0].id,subject.id,subject.id===id?'Yes':'No',subject.id===id?'PRIVATE_WITHDRAWN_JJ':'');
 const before=await api<LiveView>(tokens[0]),plan=h.songs.slice(1).map((p,n)=>({performanceId:p.id,partners:leads.map((s,i)=>[s.id,follows[(i+n)%3].id])}));const q={action:'request-withdrawal',competitionId:competition.id,roundKey:r.key,subjectId:id,reason:'Synthetic remaining lineup'};
 await command(organizer,{...q,pairingPlan:[]},400);await command(organizer,{...q,pairingPlan:[{performanceId:h.songs[0].id,partners:[]}]},400);
 const request=await command(organizer,{...q,pairingPlan:plan}) as {reviewRequestId:string};await command(head,{action:'approve-request',reviewRequestId:request.reviewRequestId,requestVersion:1});await command(organizer,{action:'approve-request',reviewRequestId:request.reviewRequestId,requestVersion:1});v=await api<LiveView>(organizer);assert.deepEqual(v.rounds[0].definition.heats[0].songs[0].partners,h.songs[0].partners);assert.deepEqual(v.rounds[0].definition.heats[0].songs[1].partners,plan[0].partners);assert.deepEqual((await api<LiveView>(tokens[0])).ballots[0].cells[cellKey(h.songs[0].id,id)],before.ballots[0].cells[cellKey(h.songs[0].id,id)]);
 await command(organizer,{action:'next'});const unscheduled=follows.find((f)=>!plan[0].partners.flat().includes(f.id))!;await save(tokens[0],r,h.songs[1].id,unscheduled.id,'Yes','',400);await save(tokens[0],r,h.songs[1].id,leads[0].id,'A1');await command(organizer,{action:'next'});await command(organizer,{action:'lineup'});
 await api(tokens[0],{action:'submit-heat',roundKey:r.key,heatId:h.id,ballotVersion:before.ballots[0].version,expectedVersion:before.version,acknowledged:true,requestId:crypto.randomUUID()},409);await command(organizer,{action:'conclude-stage'},400);for(const token of tokens)await submitHeat(token,r,h.id);await command(organizer,{action:'conclude-stage'});v=await api<LiveView>(organizer);assert.equal(v.rounds[0].standings!.rows.length,5);assert.ok(v.rounds[0].submittedMarks!.some((c)=>c.subjectId===id&&c.mark==='Yes'));assert.equal(v.rounds[0].standings!.complete,true);
});
test('fixed final couple withdrawal leaves prelim approval intact, retains scores, and excludes only the couple',async()=>{
 const setup=limitedStage(1,4),{organizer,tokens,head}=await createStage(setup);let v=await finish(setup,organizer,tokens,head,false);const pre=v.rounds.find((r)=>r.definition.kind==='prelims')!,fin=v.rounds.find((r)=>r.definition.kind==='finals')!,id=fin.definition.subjects[0].id;
 const q=await command(organizer,{action:'request-withdrawal',competitionId:fin.definition.competitionId,roundKey:fin.key,subjectId:id,reason:'Synthetic final withdrawal'}) as {reviewRequestId:string};await command(organizer,{action:'approve-request',reviewRequestId:q.reviewRequestId,requestVersion:1});await command(head,{action:'approve-request',reviewRequestId:q.reviewRequestId,requestVersion:1});v=await api<LiveView>(organizer);assert.equal(v.rounds.find((r)=>r.id===pre.id)!.standings!.approved,true);assert.equal(v.rounds.find((r)=>r.id===fin.id)!.standings!.rows.length,1);assert.equal(v.rounds.find((r)=>r.id===fin.id)!.standings!.rows[0].average,4.5);await exact(head,fin.id,'approve');await command(organizer,{action:'prepare-publication',competitionId:fin.definition.competitionId});v=await api<LiveView>(organizer);const withdrawn=v.publications![0].snapshot.stages.find((s)=>s.kind==='finals')!.entrants.find((e)=>e.withdrawn)!;assert.equal(withdrawn.observations,3);assert.equal(withdrawn.place,null);assert.equal(withdrawn.judgeMeans.length,3);
 // A post-Finals prelim withdrawal changes the approved membership. No replacement policy is invented.
 const removed=await command(organizer,{action:'request-withdrawal',competitionId:pre.definition.competitionId,roundKey:pre.key,subjectId:id,reason:'Synthetic late prelim eligibility change'}) as {reviewRequestId:string};await command(head,{action:'approve-request',reviewRequestId:removed.reviewRequestId,requestVersion:1});await command(organizer,{action:'approve-request',reviewRequestId:removed.reviewRequestId,requestVersion:1});await command(organizer,{action:'prepare-publication',competitionId:pre.definition.competitionId},400);assert.equal((await api<LiveView>(organizer)).rounds.find((r)=>r.id===fin.id)!.standings!.approved,false);
});
